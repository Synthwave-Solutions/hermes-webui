[Unit]
Description=Complete SynthPulse memory processing for all users
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/hermes-webui
Environment=HERMES_HOME=%h/.hermes
Environment=HERMES_WEBUI_AGENT_DIR=%h/.hermes/hermes-agent
Environment=MNEMOSYNE_NO_EMBEDDINGS=1
EnvironmentFile=-%h/hermes-webui/.env
ExecStart=%h/.hermes/hermes-agent/venv/bin/python %h/hermes-webui/scripts/with_agent_runtime.py %h/hermes-webui/scripts/nightly_memory.py
TimeoutStartSec=24h
Nice=10
CPUWeight=20
MemoryMax=1G
UMask=0077
